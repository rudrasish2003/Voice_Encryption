# Copy this file to .env and fill in real values.
# Generate JWT_SECRET and VOICEPRINT_ENC_KEY with: python scripts/generate_keys.py

APP_ENV=development
HOST=0.0.0.0
PORT=8000

# Local filesystem storage root for people/voiceprints/audit log (never raw audio)
DATA_DIR=./data

# MongoDB is used ONLY as the background job queue (identification_jobs collection).
# People, voiceprints and the audit log stay on local disk under DATA_DIR.
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=voice_biometric

# --- Auth (dev-only single admin user; replace with real user management in Phase 5) ---
JWT_SECRET=REPLACE_ME
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_ME

# AES-GCM key (base64, 32 bytes) used to encrypt voiceprint vectors at rest
VOICEPRINT_ENC_KEY=REPLACE_ME

# Hugging Face token required to download the pyannote speaker-diarization pipeline
HF_TOKEN=

# --- Models ---
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
EMBEDDING_MODEL=speechbrain/spkrec-ecapa-voxceleb

# --- Decision thresholds (placeholders -- tune in Phase 3) ---
MATCH_THRESHOLD=0.70
RUNNER_UP_MARGIN=0.08
# Share of detected speech the top speaker must hold during registration to be treated
# as one person despite diarization noise splitting off a second speaker label.
DOMINANT_SPEAKER_MIN_RATIO=0.70
MIN_REGISTRATION_SPEECH_SEC=30
MIN_IDENTIFY_SPEECH_SEC=3
MAX_IDENTIFY_SPEECH_SEC=60

# --- Upload limits ---
MAX_UPLOAD_DURATION_SEC=1800
MAX_UPLOAD_SIZE_MB=200

# --- Spoken self-introduction labeling ("I am Sanjana" / "Mr. X please speak") ---
# A spoken name is only ever shown as a suggestion ("claimed_unverified") for a human
# to confirm via "Add to Library" in the Identify tab -- never auto-enrolled.
ENABLE_SPOKEN_NAME_LABELING=true
WHISPER_MODEL=base
